PORT=3000
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
APP_URL=

MONGODB_URI=mongodb://127.0.0.1:27017/linkedin-scheduler
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
MISSED_GRACE_HOURS=24

# AWS S3 is optional. On Vercel, uploads are proxied through /uploads so the bucket can remain private.
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
PUBLIC_URL=
